<div{{with themeStyle "textarea-wrapper"}} style="{{.}}"{{end}}{{with themeClass "textarea-wrapper"}} class="{{.}}"{{end}}>
  <textarea
       id="{{.Field.Id}}"
       name="{{.Field.Name}}"
       rows="{{.Field.Rows}}"
       cols="{{.Field.Cols}}"
       placeholder="{{ form_print .Loc .Field.Placeholder}}"
       {{if .Field.Required}}required{{end}}
       {{if .Field.Disabled}}disabled{{end}}
       {{if .Field.ReadOnly}}readonly{{end}}
       {{with .Field.MinLength}}minlength="{{.}}"{{end}}
       {{with .Field.MaxLength}}maxlength="{{.}}"{{end}}
       {{with .Field.AutoComplete}}autocomplete="{{.}}"{{end}}
       {{with themeStyle "textarea"}}style="{{.}}"{{end}}
       {{with form_class (themeClass "textarea") .Field.Class}}class="{{.}}"{{end}}
       aria-labelledby="{{.Field.Id}}_label"
       {{with form_described_by .Field}}aria-describedby="{{.}}"{{end}}
       {{if .Field.Errors}}aria-invalid="true"{{end}}
       {{if .Field.Data}}{{ form_data_attributes .Field.Data }}{{end}}>{{.Field.Value}}</textarea>
</div>
