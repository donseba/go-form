<div{{with themeStyle "input-group"}} style="{{.}}"{{end}}{{with themeClass "input-group"}} class="{{.}}"{{end}}>
  {{if .GroupBefore}}
  <div{{with themeStyle "input-group-text"}} style="{{.}}"{{end}}{{with themeClass "input-group-text"}} class="{{.}}"{{end}}>{{.GroupBefore}}</div>
  {{end}}
  {{.Input}}
  {{if .GroupAfter}}
  <div{{with themeStyle "input-group-text"}} style="{{.}}"{{end}}{{with themeClass "input-group-text"}} class="{{.}}"{{end}}>{{.GroupAfter}}</div>
  {{end}}
</div>

