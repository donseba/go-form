<div{{with themeStyle "form-group"}} style="{{.}}"{{end}}{{with themeClass "form-group"}} class="{{.}}"{{end}}>
  <div{{with themeStyle "form-header"}} style="{{.}}"{{end}}{{with themeClass "form-header"}} class="{{.}}"{{end}}>
    <h6{{with themeStyle "form-legend"}} style="{{.}}"{{end}}{{with themeClass "form-legend"}} class="{{.}}"{{end}} id="{{.Field.Id}}_legend">{{ form_print .Loc .Field.Legend }}</h6>
  </div>
  <div{{with themeStyle "form-body"}} style="{{.}}"{{end}}{{with themeClass "form-body"}} class="{{.}}"{{end}} role="group" aria-labelledby="{{.Field.Id}}_legend">
    {{ fields }}
  </div>
</div>
