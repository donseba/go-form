<div{{with themeStyle "range-wrapper"}} style="{{.}}"{{end}}{{with themeClass "range-wrapper"}} class="{{.}}"{{end}}>
  <input type="range"
         id="{{.Field.Id}}"
         name="{{.Field.Name}}"
         value="{{.Field.Value}}"
         {{if .Field.Disabled}}disabled{{end}}
         {{if .Field.Min}}min="{{.Field.Min}}"{{end}}
         {{if .Field.Max}}max="{{.Field.Max}}"{{end}}
         {{if .Field.Step}}step="{{.Field.Step}}"{{end}}
         {{with themeStyle "range"}}style="{{.}}"{{end}}
         {{with themeClass "range"}}class="{{.}}"{{end}}
         oninput="document.getElementById('{{.Field.Id}}_value').textContent = this.value"
         aria-labelledby="{{.Field.Id}}_label"
         {{with form_described_by .Field}}aria-describedby="{{.}}"{{end}}
         {{if .Field.Errors}}aria-invalid="true"{{end}}
         {{if .Field.Data}}{{ form_data_attributes .Field.Data }}{{end}}>
  <span id="{{.Field.Id}}_value"
        {{with themeStyle "range-value"}}style="{{.}}"{{end}}
        {{with themeClass "range-value"}}class="{{.}}"{{end}}
        aria-hidden="true">{{.Field.Value}}</span>
</div>
